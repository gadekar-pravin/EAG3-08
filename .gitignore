# Secrets — NEVER commit
.env
.env.local

# Local runtime state — regenerated on each run
code/state/sessions/*/
!code/state/sessions/.gitkeep
code/sandbox/*.txt
code/.venv/
gateway/.venv/
gateway/*.db
gateway/usage.json

# Build / cache artifacts
**/__pycache__/
**/*.pyc
**/uv.lock
**/.pytest_cache/

# Editors & IDEs
# JetBrains (PyCharm, IntelliJ, etc.)
.idea/
*.iml
*.ipr
*.iws
.idea_modules/
cmake-build-*/
out/

# VS Code
.vscode/
*.code-workspace
.history/

# Other editors / temp files
*.swp
*.swo
*~
.\#*
\#*\#

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
