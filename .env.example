# Copy this file to `.env` (in this same directory) and fill in the
# values you have keys for. The gateway will auto-discover .env either
# beside the gateway (S8SharedCode/gateway/.env) or at the package root
# (S8SharedCode/.env) — first hit wins.
#
# Minimum to run anything: one worker provider + Ollama (for embeddings).
# Minimum to run research-heavy queries (web_search / fetch_url):
# TAVILY_API_KEY (Tavily) or fall back to DuckDuckGo (no key needed —
# the MCP server already handles failover).
#
# You do NOT need all providers. Set the ones you have; the gateway
# fails over through whichever subset is configured.

# ─── Worker providers (the gateway picks among them per request) ──────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Copy these from AI Studio for the Gemini project/model you are using.
# The values below match paid Tier 1 Gemini 3.1 Flash Lite in AI Studio.
GEMINI_RPM=4000
GEMINI_TPM=4000000
GEMINI_RPD=150000

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama3.1-8b

NVIDIA_API_KEY=
NVIDIA_MODEL=deepseek-ai/deepseek-v4-pro

GITHUB_ACCESS_TOKEN=
GITHUB_MODEL=openai/gpt-4.1-mini

OPEN_ROUTER_API_KEY=
# Paid OpenRouter models should omit the ":free" suffix. Free-suffix models
# keep free-model request limits even when the account has credits.
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
# Optional: set when you want to skip startup key introspection.
# paid non-free models default to no local RPM/RPD cap; upstream 429s still back off.
OPENROUTER_TIER=paid
OPENROUTER_RPM=
OPENROUTER_RPD=

# ─── Embedding (Ollama default; Gemini fallback uses GEMINI_API_KEY above) ─
OLLAMA_URL=http://localhost:11434
EMBED_OLLAMA_MODEL=nomic-embed-text

# ─── MCP tool keys ─────────────────────────────────────────────────────────
TAVILY_API_KEY=              # optional; DDG is the fallback

# ─── Optional gateway tunables ─────────────────────────────────────────────
# LLM_ORDER=ollama,gemini,nvidia,groq,cerebras,openrouter,github
# GATEWAY_V8_PORT=8108
